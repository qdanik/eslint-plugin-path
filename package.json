{
  "name": "eslint-plugin-path",
  "version": "3.0.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "author": "qDanik <qdanik@yandex.ru>",
  "license": "MIT",
  "homepage": "https://github.com/qDanik/eslint-plugin-path#readme",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "absolute-path",
    "path",
    "relative-import"
  ],
  "files": [
    "lib/",
    "src/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "npm@11.2.0",
  "repository": "qDanik/eslint-plugin-path",
  "scripts": {
    "format": "biome lint --write --unsafe && biome format --write && biome check --write --unsafe",
    "lint": "biome check",
    "build": "rm -rf ./tsconfig.tsbuildinfo && tsc -b",
    "pretest": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest --silent --runInBand",
    "test:coverage": "jest --silent --runInBand --coverage"
  },
  "dependencies": {
    "load-tsconfig": "^0.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "directories": {
    "docs": "docs"
  }
}
